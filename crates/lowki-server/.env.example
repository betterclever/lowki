# Required
LOWKI_PUBLIC_URL=https://auth.example.com
# openssl rand -hex 32
LOWKI_SERVER_SECRET=
# openssl rand -hex 24   (leave empty to disable the admin API)
LOWKI_ADMIN_TOKEN=

# Passkeys (defaults: RP ID = host of LOWKI_PUBLIC_URL, origins = LOWKI_PUBLIC_URL)
# LOWKI_RP_ID=example.com
# LOWKI_ORIGINS=https://auth.example.com

# Google sign-in (or any OIDC provider via LOWKI_OIDC_ISSUER)
# LOWKI_OIDC_CLIENT_ID=
# LOWKI_OIDC_CLIENT_SECRET=

# Email codes: smtp | log (dev only) | disabled
# LOWKI_EMAIL_SENDER=smtp
# LOWKI_SMTP_URL=smtps://user:password@smtp.example.com:465
# LOWKI_EMAIL_FROM=Lowki <no-reply@example.com>

# Postgres instead of SQLite (with `--profile postgres`)
# LOWKI_DATABASE_URL=postgres://lowki:change-me@postgres:5432/lowki
