{
  "name": "@lowki/react-auth",
  "version": "0.1.0",
  "description": "Privy-compatible React SDK for the Lowki embedded wallet: same hooks, keys stay on the user's device, private sends built in",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wagmi": {
      "types": "./dist/wagmi.d.ts",
      "import": "./dist/wagmi.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "peerDependencies": {
    "@wagmi/core": "^2 || ^3",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@wagmi/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@wagmi/core": "2.22.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "viem": "2.57.16",
    "vitest": "4.1.12"
  }
}
