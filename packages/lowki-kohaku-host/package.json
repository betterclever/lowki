{
  "name": "@lowki/kohaku-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kohaku @kohaku-eth/plugins Host implemented on top of the Lowki Rust/wasm worker (keystore, encrypted storage, network, provider)",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --import ./resolve-hook.mjs --import tsx --test test/*.test.ts",
    "test:stub": "LOWKI_WORKER=stub node --import ./resolve-hook.mjs --import tsx --test test/*.test.ts",
    "sepolia-sync": "node --import ./resolve-hook.mjs --import tsx scripts/sepolia-sync.ts"
  },
  "dependencies": {
    "@anon-rpc/browser-harness": "0.4.0",
    "@fatsolutions/privacy-pools-core-circuits": "1.0.5",
    "@noble/hashes": "2.2.0",
    "@reduxjs/toolkit": "2.12.0",
    "@saga-sync/client": "0.3.0",
    "@scure/bip32": "2.2.0",
    "@scure/bip39": "2.2.0",
    "ethers": "6.17.0",
    "maci-crypto": "2.5.0",
    "ox": "0.12.4",
    "viem": "2.54.1"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "tsx": "4.22.5",
    "typescript": "5.9.3"
  }
}
