{
  "name": "privy-swap-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:sdk": "npm --prefix ../../packages/lowki-react-auth run build",
    "typecheck:privy": "tsc -p tsconfig.privy.json",
    "typecheck:lowki": "tsc -p tsconfig.lowki.json",
    "typecheck": "npm run build:sdk && npm run typecheck:privy && npm run typecheck:lowki",
    "dev": "vite",
    "build": "npm run build:sdk && vite build",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@lowki/react-auth": "file:../../packages/lowki-react-auth",
    "@privy-io/react-auth": "3.51.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
